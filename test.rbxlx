            <string name="Source"><![CDATA[-- Client bootstrap script
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local System = require(ReplicatedStorage:WaitForChild("CoreSystem"))

System.namespace("RobloxCSharp.Client", function (namespace)
  namespace.class("MainClient", function (namespace)
    local Init
    Init = function ()
      print("[КЛИЕНТ C#] Добро пожаловать в игру Roblox на C#! Клиент готов.")
    end

    task.defer(Init)

    return {
      Init = Init
    }
  end)
end)
]]></string>
