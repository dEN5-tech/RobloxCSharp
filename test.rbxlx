    <Item class="ModuleScript" referent="1">
      <Properties>
        <string name="Name">CoreSystem</string>
        <string name="Source"><![CDATA[-- Lightweight Roblox Luau CoreSystem for CSharp.lua
local System = {}
System.__index = System

local namespaces = {}

function System.namespace(name, fn)
    local ns = namespaces[name] or {}
    namespaces[name] = ns
    
    local builder = {
        class = function(className, classFn)
            local cls = classFn(ns) or {}
            cls.__index = cls
            ns[className] = cls
            return cls
        end,
        struct = function(structName, structFn)
            local st = structFn(ns) or {}
            st.__index = st
            ns[structName] = st
            return st
        end
    }
    
    fn(builder)
    return ns
end

function System.cast(targetType, obj)
    return obj
end

function System.as(obj, targetType)
    return obj
end

function System.is(obj, targetType)
    return obj ~= nil
end

function System.toString(val)
    if val == nil then return "" end
    return tostring(val)
end

System.Console = {
    WriteLine = function(text)
        print(text)
    end,
    Write = function(text)
        print(text)
    end
}

return System
]]></string>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="2">
      <Properties>
        <string name="Name">RobloxAPI</string>
        <string name="Source"><![CDATA[-- Roblox API Wrapper for CSharp.lua
local Roblox = {}

Roblox.Game = {
    GetService = function(name)
        return game:GetService(name)
    end,
    getWorkspace = function()
        return workspace
    end,
    getPlayers = function()
        return game:GetService("Players")
    end,
    Workspace = workspace,
    Players = game:GetService("Players")
}

Roblox.Instance = {
    New = function(className, parent)
        if parent then
            return Instance.new(className, parent)
        else
            return Instance.new(className)
        end
    end
}

Roblox.Vector3 = {
    New = function(x, y, z)
        return Vector3.new(x, y, z)
    end
}

Roblox.Color3 = {
    FromRGB = function(r, g, b)
        return Color3.fromRGB(r, g, b)
    end
}

return Roblox
]]></string>
      </Properties>
      <Item class="ModuleScript" referent="3">
