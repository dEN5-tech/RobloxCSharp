      <Item class="ModuleScript" referent="9">
        <Properties>
          <string name="Name">MainServer</string>
          <string name="Source"><![CDATA[-- Generated by CSharp.lua Compiler
local System = System
local Roblox = Roblox
System.namespace("RobloxCSharp.Server", function (namespace)
  -- Простая игровая логика для сбора монеток и таблицы лидеров (Leaderstats)
  namespace.class("MainServer", function (namespace)
    local Init, SetupLeaderstats, SpawnCoin
    Init = function ()
      System.Console.WriteLine("[СЕРВЕР] Инициализация игры на C# началась!")

      -- 1. Настройка таблицы очков (Leaderstats) при входе игрока
      SetupLeaderstats()

      -- 2. Создание начальных монеток на карте
      SpawnCoin(0, 5, 0, "Золотая Монетка 1")
      SpawnCoin(10, 5, 0, "Золотая Монетка 2")
      SpawnCoin(- 10, 5, 0, "Золотая Монетка 3")

      System.Console.WriteLine("[СЕРВЕР] Все монетки созданы и игра готова к запуску!")
    end
    SetupLeaderstats = function ()
      Roblox.Game.getPlayers():OnPlayerAdded(function (playerInstance)
        System.Console.WriteLine("[СЕРВЕР] Игрок подключился: " .. System.toString(playerInstance.Name))

        -- Создаем папку leaderstats внутри игрока (стандарт Roblox)
        local leaderstats = System.cast(Roblox.Folder, Roblox.Instance.New("Folder"))
        leaderstats.Name = "leaderstats"
        leaderstats.Parent = playerInstance

        -- Создаем счетчик монеток
        local coins = System.cast(Roblox.IntValue, Roblox.Instance.New("IntValue"))
        coins.Name = "Монеты"
        coins.Value = 0
        -- Начальный баланс
        coins.Parent = leaderstats
      end)
    end
    SpawnCoin = function (x, y, z, coinName)
      -- Создаем блок монетки
      local coin = System.cast(Roblox.Part, Roblox.Instance.New("Part"))
      coin.Name = coinName
      coin.Size = Roblox.Vector3.New(2, 2, 2)
      coin.Position = Roblox.Vector3.New(x, y, z)
      coin.Color = Roblox.Color3.FromRGB(255, 215, 0)
      -- Золотой цвет
      coin.Anchored = true
      -- Зафиксировать в воздухе
      coin.CanCollide = false
      -- Проходим сквозь нее
      coin.Parent = Roblox.Game.getWorkspace()

      -- Обработка касания монетки игроком
      coin:OnTouched(function (hit)
        -- Проверяем, коснулся ли персонаж игрока
        if hit ~= nil and hit.Parent ~= nil then
          local player = Roblox.Game.getPlayers():GetPlayerFromCharacter(hit.Parent)
          if player ~= nil then
            local leaderstats = player:FindFirstChild("leaderstats")
            if leaderstats ~= nil then
              local coins = System.cast(Roblox.IntValue, leaderstats:FindFirstChild("Монеты"))
              if coins ~= nil then
                -- Начисляем 10 монет
                coins.Value = coins.Value + 10
                System.Console.WriteLine("[ИГРА] Игрок " .. System.toString(player.Name) .. " собрал " .. System.toString(coinName) .. "! Баланс: " .. coins.Value)

                -- Удаляем собранную монетку
                coin:Destroy()
              end
            end
          end
        end
      end)
    end
    return {
      Init = Init
    }
  end)
end)
]]></string>
