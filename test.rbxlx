      <Item class="Script" referent="10">
        <Properties>
          <string name="Name">MainServer</string>
          <token name="RunContext">0</token>
          <string name="Source"><![CDATA[-- Generated by CSharp.lua & Auto-bootstrapped for Roblox Studio
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Players = game:GetService("Players")
local System = require(ReplicatedStorage:WaitForChild("CoreSystem"))
local Roblox = require(ReplicatedStorage:WaitForChild("RobloxAPI"))

System.namespace("RobloxCSharp.Server", function (namespace)
  -- Простая игровая логика для сбора монеток и таблицы лидеров (Leaderstats)
  namespace.class("MainServer", function (namespace)
    local Init, SetupLeaderstats, CreateLeaderstatsForPlayer, SpawnCoin
    
    CreateLeaderstatsForPlayer = function (playerInstance)
      if playerInstance:FindFirstChild("leaderstats") then return end
      print("[СЕРВЕР C#] Создание leaderstats для игрока: " .. tostring(playerInstance.Name))

      -- Создаем папку leaderstats внутри игрока (стандарт Roblox)
      local leaderstats = Instance.new("Folder")
      leaderstats.Name = "leaderstats"
      leaderstats.Parent = playerInstance

      -- Создаем счетчик монеток
      local coins = Instance.new("IntValue")
      coins.Name = "Монеты"
      coins.Value = 0
      coins.Parent = leaderstats
    end

    SetupLeaderstats = function ()
      -- Для новых игроков
      Players.PlayerAdded:Connect(function (playerInstance)
        CreateLeaderstatsForPlayer(playerInstance)
      end)

      -- Для уже подключенных игроков (если скрипт стартует позже)
      for _, player in ipairs(Players:GetPlayers()) do
        CreateLeaderstatsForPlayer(player)
      end
    end

    SpawnCoin = function (x, y, z, coinName)
      -- Создаем блок монетки
      local coin = Instance.new("Part")
      coin.Name = coinName
      coin.Size = Vector3.new(2, 2, 2)
      coin.Position = Vector3.new(x, y, z)
      coin.Color = Color3.fromRGB(255, 215, 0) -- Золотой цвет
      coin.Material = Enum.Material.Neon
      coin.Anchored = true
      coin.CanCollide = false
      coin.Parent = workspace

      -- Обработка касания монетки игроком
      coin.Touched:Connect(function (hit)
        if hit and hit.Parent then
          local player = Players:GetPlayerFromCharacter(hit.Parent)
          if player then
            local leaderstats = player:FindFirstChild("leaderstats")
            if leaderstats then
              local coins = leaderstats:FindFirstChild("Монеты")
              if coins then
                -- Начисляем 10 монет
                coins.Value = coins.Value + 10
                print("[ИГРА C#] Игрок " .. tostring(player.Name) .. " собрал " .. tostring(coinName) .. "! Баланс монет: " .. tostring(coins.Value))

                -- Эффект подбора: удаляем монетку
                coin:Destroy()
              end
            end
          end
        end
      end)
    end

    Init = function ()
      print("=================================================")
      print("[СЕРВЕР C#] Инициализация игры на C# началась!")
      print("=================================================")

      -- 1. Настройка таблицы очков (Leaderstats)
      SetupLeaderstats()

      -- 2. Спавн 3 золотых монеток вокруг спавна
      SpawnCoin(0, 3, 10, "Золотая Монетка #1")
      SpawnCoin(12, 3, 10, "Золотая Монетка #2")
      SpawnCoin(-12, 3, 10, "Золотая Монетка #3")

      print("[СЕРВЕР C#] 3 монетки успешно заспавнены в Workspace!")
      print("[СЕРВЕР C#] Серверная логика готова к игре!")
    end

    -- Автоматический запуск логики
    task.defer(Init)

    return {
      Init = Init
    }
  end)
end)
]]></string>
