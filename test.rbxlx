          <string name="Name">Attributes</string>
          <string name="Source"><![CDATA[-- Generated by CSharp.lua Compiler
local System = System
System.namespace("CSharpLua", function (namespace)
  namespace.class("TemplateAttribute", function (namespace)
    local __ctor1__, __ctor2__
    __ctor1__ = function (this)
      System.base(this).__ctor__(this)
    end
    __ctor2__ = function (this, template)
      System.base(this).__ctor__(this)
      this.Template = template
    end
    return {
      base = function (out)
        return {
          System.Attribute
        }
      end,
      __ctor__ = {
        __ctor1__,
        __ctor2__
      }
    }
  end)

  namespace.class("ExternalAttribute", function (namespace)
    return {
      base = function (out)
        return {
          System.Attribute
        }
      end
    }
  end)

  namespace.class("IgnoreAttribute", function (namespace)
    return {
      base = function (out)
        return {
          System.Attribute
        }
      end
    }
  end)
end)
]]></string>
